{
  "version": "IPIP-50",
  "scale": {
    "min": 1,
    "max": 5,
    "labels": {
      "1": "非常不同意",
      "2": "不同意",
      "3": "中立",
      "4": "同意",
      "5": "非常同意"
    }
  },
  "dimensions": {
    "openness": { "name": "开放性", "key": "O" },
    "conscientiousness": { "name": "尽责性", "key": "C" },
    "extraversion": { "name": "外向性", "key": "E" },
    "agreeableness": { "name": "宜人性", "key": "A" },
    "neuroticism": { "name": "神经质", "key": "N" }
  },
  "questions": [
    { "id": 1, "dimension": "extraversion", "direction": 1, "text": "在聚会或饭局上，我通常是主动开启话题的那个人。" },
    { "id": 2, "dimension": "extraversion", "direction": 1, "text": "热闹的场合（如市集、演出）通常让我兴奋，而不是疲惫。" },
    { "id": 3, "dimension": "extraversion", "direction": 1, "text": "在一群人里，我经常是调动气氛的那个。" },
    { "id": 4, "dimension": "extraversion", "direction": 1, "text": "到新环境（新公司、新班级）时，我能比较快地和周围人熟络起来。" },
    { "id": 5, "dimension": "extraversion", "direction": 1, "text": "遇到开心的事，我会很想马上分享给朋友或家人。" },
    { "id": 6, "dimension": "extraversion", "direction": -1, "text": "人多的聚会结束后，我通常觉得累，想自己待一会儿。" },
    { "id": 7, "dimension": "extraversion", "direction": -1, "text": "在一群不太熟的人里，我更多听别人说，自己很少开口。" },
    { "id": 8, "dimension": "extraversion", "direction": -1, "text": "需要打电话沟通的事，我常常希望改成打字解决。" },
    { "id": 9, "dimension": "extraversion", "direction": -1, "text": "讨论中即使我有不同看法，也常常选择不说。" },
    { "id": 10, "dimension": "extraversion", "direction": -1, "text": "遇到不认识的人，我一般不会主动搭话，除非对方先开口。" },

    { "id": 11, "dimension": "agreeableness", "direction": 1, "text": "朋友心情不好时，我会主动问问发生了什么，陪着聊一会儿。" },
    { "id": 12, "dimension": "agreeableness", "direction": 1, "text": "看到有人搬重物或需要帮助时，我会主动搭把手。" },
    { "id": 13, "dimension": "agreeableness", "direction": 1, "text": "发生误会时，我通常愿意先相信对方不是故意的。" },
    { "id": 14, "dimension": "agreeableness", "direction": 1, "text": "和朋友有分歧时，我会直接说出真实想法，而不是表面答应、背后不照做。" },
    { "id": 15, "dimension": "agreeableness", "direction": 1, "text": "别人向我倾诉烦恼时，我会耐心听完，而不是急着打断。" },
    { "id": 16, "dimension": "agreeableness", "direction": -1, "text": "我对他人其实不太感兴趣" },
    { "id": 17, "dimension": "agreeableness", "direction": -1, "text": "我有时会冒犯别人" },
    { "id": 18, "dimension": "agreeableness", "direction": -1, "text": "别人找我帮忙但会耽误我的事时，我多半会找借口推掉。" },
    { "id": 19, "dimension": "agreeableness", "direction": -1, "text": "不熟的人遇到的困难，我一般不太关心。" },
    { "id": 20, "dimension": "agreeableness", "direction": -1, "text": "别人很难真正了解我" },

    { "id": 21, "dimension": "conscientiousness", "direction": 1, "text": "答应别人的事，哪怕是小事，我也会记在心上并做到。" },
    { "id": 22, "dimension": "conscientiousness", "direction": 1, "text": "完成一项任务后，我会检查一遍再交出去。" },
    { "id": 23, "dimension": "conscientiousness", "direction": 1, "text": "我的桌面或手机文件大致是分类整理好的，找东西不费劲。" },
    { "id": 24, "dimension": "conscientiousness", "direction": 1, "text": "即使想拖延，我也会先把重要的事做完再休息。" },
    { "id": 25, "dimension": "conscientiousness", "direction": 1, "text": "要办的事一多，我习惯列成清单逐项完成。" },
    { "id": 26, "dimension": "conscientiousness", "direction": -1, "text": "一件事拖到临近截止才开始赶，对我来说是常事。" },
    { "id": 27, "dimension": "conscientiousness", "direction": -1, "text": "我的东西经常随手放，要用的时候得找半天。" },
    { "id": 28, "dimension": "conscientiousness", "direction": -1, "text": "出门后才发现忘带东西（钥匙、充电器等），这种情况我时不时会遇到。" },
    { "id": 29, "dimension": "conscientiousness", "direction": -1, "text": "定下的计划（如锻炼、早起），我常常坚持不了多久就放弃了。" },
    { "id": 30, "dimension": "conscientiousness", "direction": -1, "text": "约好时间见面，我偶尔会因为磨蹭而迟到。" },

    { "id": 31, "dimension": "neuroticism", "direction": 1, "text": "第二天有重要安排时，我前一晚容易反复想这件事，睡不踏实。" },
    { "id": 32, "dimension": "neuroticism", "direction": 1, "text": "被人说了一句不中听的话后，我会反复琢磨很久。" },
    { "id": 33, "dimension": "neuroticism", "direction": 1, "text": "发消息对方没回，我容易猜是不是自己说错了什么。" },
    { "id": 34, "dimension": "neuroticism", "direction": 1, "text": "外卖送错、排队久等这类事发生时，我容易一下子就火大。" },
    { "id": 35, "dimension": "neuroticism", "direction": 1, "text": "心情不好时，我容易靠大吃大喝或冲动购物来缓解。" },
    { "id": 36, "dimension": "neuroticism", "direction": -1, "text": "计划临时变了，我通常能很快调整，不太影响心情。" },
    { "id": 37, "dimension": "neuroticism", "direction": -1, "text": "遇到烦心事，我一般过一阵就过去了，不会反复想。" },
    { "id": 38, "dimension": "neuroticism", "direction": -1, "text": "截止日临近时，我大多能保持平静，按节奏把事情做完。" },
    { "id": 39, "dimension": "neuroticism", "direction": -1, "text": "在大家面前发言时，我通常比较镇定，不会明显紧张。" },
    { "id": 40, "dimension": "neuroticism", "direction": -1, "text": "事情没做好时，我更多是想办法补救，而不是责怪自己。" },

    { "id": 41, "dimension": "openness", "direction": 1, "text": "周末有空时，我常想尝试一家没吃过的餐厅或一种没试过的活动。" },
    { "id": 42, "dimension": "openness", "direction": 1, "text": "看电影或刷视频时，我会留意画面美感、配乐或拍摄手法。" },
    { "id": 43, "dimension": "openness", "direction": 1, "text": "和朋友聊天时，我喜欢讨论脑洞话题。" },
    { "id": 44, "dimension": "openness", "direction": 1, "text": "听到和自己不同的观点时，我会先想想，他说得有道理吗。" },
    { "id": 45, "dimension": "openness", "direction": 1, "text": "我脑子里经常会冒出改进做事方法的小点子。" },
    { "id": 46, "dimension": "openness", "direction": -1, "text": "吃饭点菜时，我通常选吃过的那几样，很少点新菜。" },
    { "id": 47, "dimension": "openness", "direction": -1, "text": "看一部电影时，我主要关心剧情，不太注意画面和音乐。" },
    { "id": 48, "dimension": "openness", "direction": -1, "text": "遇到和自己完全不同的看法时，我的第一反应通常是，这不对。" },
    { "id": 49, "dimension": "openness", "direction": -1, "text": "冷知识或冷门领域，我一般提不起兴趣去了解。" },
    { "id": 50, "dimension": "openness", "direction": -1, "text": "每天走同样的路线、吃熟悉的东西，我觉得挺好，不需要变化。" }
  ]
}
